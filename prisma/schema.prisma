generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────
model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(USER)
  adminRole    String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications    Application[]
  documents       Document[]
  payments        Payment[]
  policies        InsurancePolicy[]
  refreshTokens   RefreshToken[]
  holidayBookings HolidayBooking[]
  clubMembership  ClubMembership?

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ─── Refresh Tokens ──────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Applications ─────────────────────────────────────────────────────────────
model Application {
  id                String            @id @default(uuid())
  ref               String            @unique
  userId            String
  user              User              @relation(fields: [userId], references: [id])

  destination       String
  purpose           String
  visaType          String?
  travelDate        DateTime?
  returnDate        DateTime?

  applicantName     String
  email             String
  phone             String?
  nationality       String?
  passportNumber    String?
  passportExpiry    DateTime?
  passportIssueDate DateTime?
  dob               DateTime?

  referralCode      String?
  agentSubmitted    Boolean           @default(false)

  status            ApplicationStatus @default(RECEIVED)
  paid              Boolean           @default(false)
  fee               Int               @default(0)

  feeBreakdown      Json?
  travellers        Json?

  deliveredAt       DateTime?
  deletedAt         DateTime?
  archivedUserId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statusHistory     StatusHistory[]
  documents         Document[]
  payments          Payment[]
  review            Review?

  @@index([userId])
  @@index([status])
  @@index([referralCode])
  @@index([createdAt])
  @@index([userId, status])
  @@map("applications")
}

enum ApplicationStatus {
  RECEIVED
  PROCESSING
  EMBASSY
  APPROVED
  DELIVERED
  REJECTED
}

model StatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("status_history")
}

// ─── Documents ───────────────────────────────────────────────────────────────
model Document {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  name          String
  key           String
  mimeType      String
  size          Int
  docIndex      Int?

  uploadedAt    DateTime @default(now())

  @@index([userId])
  @@index([applicationId])
  @@map("documents")
}

// ─── Payments ────────────────────────────────────────────────────────────────
model Payment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application?  @relation(fields: [applicationId], references: [id])

  reference     String        @unique
  type          PaymentType
  amount        Int
  status        PaymentStatus @default(INITIATED)
  metadata      Json?

  initiatedAt   DateTime @default(now())
  paidAt        DateTime?

  @@index([applicationId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

enum PaymentType {
  VISA
  INSURANCE
  CONSULTATION
  FLIGHT
  HOTEL
  HOLIDAY
  CLUB_MEMBERSHIP
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

// ─── Insurance ───────────────────────────────────────────────────────────────
model InsurancePolicy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  paymentRef  String   @unique

  plan        String
  destination String?
  travelDate  DateTime?
  travellers  Int      @default(1)
  amount      Int
  status      String   @default("active")

  purchasedAt DateTime @default(now())

  @@map("insurance_policies")
}

// ─── Fees ────────────────────────────────────────────────────────────────────
model Fee {
  id        String   @id @default(uuid())
  country   String   @unique
  amount    Int
  isDefault Boolean  @default(false)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("fees")
}

model ServiceFee {
  id        String   @id @default("singleton")
  amount    Int      @default(25000)
  updatedAt DateTime @updatedAt

  @@map("service_fee")
}

model PricingConfig {
  id                   String   @id @default("singleton")
  consultStandard      Int      @default(15000)
  consultPriority      Int      @default(25000)
  consultVip           Int      @default(50000)
  insuranceBasic       Int      @default(25000)
  insuranceStandard    Int      @default(45000)
  insurancePremium     Int      @default(80000)
  processingFeePercent Int      @default(5)
  clubMembershipFee    Int      @default(150000)
  updatedAt            DateTime @updatedAt

  @@map("pricing_config")
}

// ─── Visa Requirements ───────────────────────────────────────────────────────
model VisaRequirement {
  id         String   @id @default(uuid())
  country    String   @unique
  flag       String?
  region     String?
  visaType   String?
  fee        String?
  processing String?
  docs       Json?
  updatedAt  DateTime @updatedAt

  @@map("visa_requirements")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────
model Review {
  id             String   @id @default(uuid())
  applicationRef String   @unique
  userId         String?
  name           String
  destination    String
  rating         Int
  text           String
  approved       Boolean  @default(false)
  surveyToken    String   @unique
  surveyUsed     Boolean  @default(false)
  surveysentAt   DateTime?
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationRef], references: [ref])

  @@index([approved])
  @@index([userId])
  @@map("reviews")
}

// ─── Affiliates ───────────────────────────────────────────────────────────────
model Affiliate {
  id           String          @id @default(uuid())
  userId       String?
  name         String
  email        String          @unique
  phone        String
  location     String?
  channel      String?
  audienceSize String?
  profileUrl   String?
  motivation   String?

  bankAccount  String
  bankName     String
  accountName  String

  referralCode String          @unique
  status       AffiliateStatus @default(PENDING)

  totalClicks    Int @default(0)
  totalReferrals Int @default(0)
  totalEarned    Int @default(0)
  totalPaid      Int @default(0)
  balance        Int @default(0)

  payouts AffiliatePayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("affiliates")
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
}

model AffiliatePayout {
  id            String       @id @default(uuid())
  affiliateId   String
  affiliate     Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amount        Int
  status        PayoutStatus @default(PENDING)
  bankName      String
  accountNumber String
  accountName   String
  note          String?

  requestedAt DateTime @default(now())
  processedAt DateTime?

  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSED
}

// ─── Magic Tokens ────────────────────────────────────────────────────────────
model MagicToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  isNewUser Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("magic_tokens")
}

// ─── OTP Tokens ──────────────────────────────────────────────────────────────
model OtpToken {
  id        String   @id @default(uuid())
  key       String   @unique
  otp       String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_tokens")
}

// ─── Page View Tracking ───────────────────────────────────────────────────────
model PageView {
  id          String   @id @default(uuid())
  page        String
  referrer    String?
  sessionId   String?
  userId      String?
  duration    Int?
  scrollDepth Int?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([page])
  @@index([sessionId])
  @@index([createdAt])
  @@index([userId])
  @@map("page_views")
}

// ─── Holidays ────────────────────────────────────────────────────────────────
model Holiday {
  id               String        @id @default(uuid())
  region           String
  state            String
  packageName      String
  tagline          String
  tier             HolidayTier
  durationDays     Int
  durationNights   Int
  priceExplorer    Int?
  priceSignature   Int?
  priceExecutive   Int?
  experienceType   String
  attractions      Json
  inclusions       Json
  images           Json          @default("[]")
  status           HolidayStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  dates            HolidayDate[]
  bookings         HolidayBooking[]

  @@unique([state, packageName])
  @@index([region])
  @@index([tier])
  @@index([status])
  @@map("holidays")
}

enum HolidayTier {
  EXPLORER
  SIGNATURE
  EXECUTIVE
}

enum HolidayStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model HolidayDate {
  id          String    @id @default(uuid())
  holidayId   String
  holiday     Holiday   @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  date        DateTime
  endDate     DateTime?
  capacity    Int       @default(20)
  bookedCount Int       @default(0)
  createdAt   DateTime  @default(now())

  bookings HolidayBooking[]

  @@index([holidayId])
  @@index([date])
  @@map("holiday_dates")
}

model HolidayBooking {
  id              String               @id @default(uuid())
  ref             String               @unique
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  holidayId       String
  holiday         Holiday              @relation(fields: [holidayId], references: [id])
  holidayDateId   String
  holidayDate     HolidayDate          @relation(fields: [holidayDateId], references: [id])

  tier            HolidayTier
  travellers      Int
  leadName        String
  leadEmail       String
  leadPhone       String?

  tierAmount      Int
  membershipAdded Boolean              @default(false)
  membershipAmount Int                 @default(0)
  totalAmount     Int

  status          HolidayBookingStatus @default(PENDING)
  paymentRef      String?              @unique
  paidAt          DateTime?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([holidayId])
  @@index([status])
  @@index([createdAt])
  @@map("holiday_bookings")
}

enum HolidayBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ─── Travel Club ─────────────────────────────────────────────────────────────
model ClubMembership {
  id          String               @id @default(uuid())
  userId      String               @unique
  user        User                 @relation(fields: [userId], references: [id])

  status      ClubMembershipStatus @default(ACTIVE)
  startDate   DateTime             @default(now())
  expiryDate  DateTime
  amountPaid  Int
  paymentRef  String               @unique

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
  @@map("club_memberships")
}

enum ClubMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model ClubPerk {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("club_perks")
}
